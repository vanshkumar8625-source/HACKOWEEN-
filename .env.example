# Backend Configuration
PORT=8000
ENVIRONMENT=development
# Leave DATABASE_URL empty or commented to automatically use local SQLite (disaster_coord.db)
# DATABASE_URL=postgresql://user:password@localhost:5432/resqnet
DATABASE_URL=sqlite:///./disaster_coord.db

# Security
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External APIs (Optional - Fallbacks provided for demo)
# GROQ_API_KEY=your_groq_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# Frontend Configuration
VITE_API_URL=http://localhost:8000
